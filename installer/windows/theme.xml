<?xml version="1.0" encoding="utf-8"?>
<!-- Aegean Office Setup's window, for WiX's standard bootstrapper application (thmutil format).
     Every page opens with the Aegean Logic banner, as each app's own Setup does. Strings are in
     theme.wxl; the named controls are the ones the standard bootstrapper application drives. -->
<Theme xmlns="http://wixtoolset.org/schemas/v4/thmutil">
    <Font Id="0" Height="-12" Weight="400" Foreground="windowtext" Background="window">Segoe UI</Font>
    <Font Id="1" Height="-20" Weight="600" Foreground="windowtext" Background="window">Segoe UI</Font>
    <Font Id="2" Height="-12" Weight="400" Foreground="windowtext" Background="window">Segoe UI</Font>
    <Font Id="3" Height="-13" Weight="600" Foreground="windowtext" Background="window">Segoe UI</Font>
    <Font Id="4" Height="-11" Weight="400" Foreground="graytext" Background="window">Segoe UI</Font>

    <Window Width="560" Height="400" HexStyle="100a0000" FontId="0" Caption="#(loc.Caption)">
        <ImageControl X="0" Y="0" Width="560" Height="92" ImageFile="banner.png" Visible="yes" />

        <Page Name="Help">
            <Label X="24" Y="112" Width="-24" Height="28" FontId="1" DisablePrefix="yes">#(loc.HelpHeader)</Label>
            <Label X="24" Y="148" Width="-24" Height="-56" FontId="2" DisablePrefix="yes">#(loc.HelpText)</Label>
            <Button Name="HelpCloseButton" X="-16" Y="-16" Width="88" Height="26" TabStop="yes" FontId="0">
                <Text>#(loc.HelpCloseButton)</Text>
                <CloseWindowAction />
            </Button>
        </Page>

        <Page Name="Loading">
            <Label Name="CheckingForUpdatesLabel" X="24" Y="112" Width="-24" Height="28" FontId="1" DisablePrefix="yes" Visible="no" />
        </Page>

        <Page Name="Install">
            <Label X="24" Y="108" Width="-24" Height="28" FontId="1" DisablePrefix="yes">#(loc.InstallHeader)</Label>
            <Label X="24" Y="140" Width="-24" Height="36" FontId="2" DisablePrefix="yes">#(loc.InstallMessage)</Label>

            <ImageControl X="76" Y="186" Width="48" Height="48" ImageFile="gridlogic.png" />
            <Label X="20" Y="240" Width="160" Height="18" FontId="3" Center="yes" DisablePrefix="yes">GridLogic</Label>
            <Label X="20" Y="258" Width="160" Height="18" FontId="4" Center="yes" DisablePrefix="yes">#(loc.GridLogicKind)</Label>
            <ImageControl X="256" Y="186" Width="48" Height="48" ImageFile="wordlogic.png" />
            <Label X="200" Y="240" Width="160" Height="18" FontId="3" Center="yes" DisablePrefix="yes">WordLogic</Label>
            <Label X="200" Y="258" Width="160" Height="18" FontId="4" Center="yes" DisablePrefix="yes">#(loc.WordLogicKind)</Label>
            <ImageControl X="436" Y="186" Width="48" Height="48" ImageFile="slidelogic.png" />
            <Label X="380" Y="240" Width="160" Height="18" FontId="3" Center="yes" DisablePrefix="yes">SlideLogic</Label>
            <Label X="380" Y="258" Width="160" Height="18" FontId="4" Center="yes" DisablePrefix="yes">#(loc.SlideLogicKind)</Label>

            <!-- Named like the bundle variable, so the standard bootstrapper application keeps them in step. -->
            <Checkbox Name="DesktopShortcuts" X="24" Y="296" Width="-24" Height="20" TabStop="yes" FontId="0">#(loc.InstallDesktopShortcuts)</Checkbox>

            <Label X="24" Y="-20" Width="200" Height="18" FontId="4" DisablePrefix="yes">#(loc.InstallVersion)</Label>
            <Button Name="InstallButton" X="-112" Y="-16" Width="88" Height="26" TabStop="yes" FontId="0">#(loc.InstallInstallButton)</Button>
            <Button Name="InstallCancelButton" X="-16" Y="-16" Width="88" Height="26" TabStop="yes" FontId="0">
                <Text>#(loc.InstallCancelButton)</Text>
                <CloseWindowAction />
            </Button>
        </Page>

        <Page Name="Progress">
            <Label X="24" Y="108" Width="-24" Height="28" FontId="1" DisablePrefix="yes">#(loc.ProgressHeader)</Label>
            <Label Name="OverallProgressPackageText" X="24" Y="156" Width="-24" Height="20" FontId="2" DisablePrefix="yes">#(loc.OverallProgressPackageText)</Label>
            <Progressbar Name="OverallCalculatedProgressbar" X="24" Y="182" Width="-24" Height="16" />
            <Button Name="ProgressCancelButton" X="-16" Y="-16" Width="88" Height="26" TabStop="yes" FontId="0">#(loc.ProgressCancelButton)</Button>
        </Page>

        <Page Name="Modify">
            <Label X="24" Y="108" Width="-24" Height="28" FontId="1" DisablePrefix="yes">#(loc.ModifyHeader)</Label>
            <Label X="24" Y="140" Width="-24" Height="40" FontId="2" DisablePrefix="yes">#(loc.ModifyMessage)</Label>
            <Button Name="RepairButton" X="-208" Y="-16" Width="88" Height="26" TabStop="yes" FontId="0" HideWhenDisabled="yes">#(loc.ModifyRepairButton)</Button>
            <Button Name="UninstallButton" X="-112" Y="-16" Width="88" Height="26" TabStop="yes" FontId="0">#(loc.ModifyUninstallButton)</Button>
            <Button Name="ModifyCancelButton" X="-16" Y="-16" Width="88" Height="26" TabStop="yes" FontId="0">
                <Text>#(loc.ModifyCancelButton)</Text>
                <CloseWindowAction />
            </Button>
        </Page>

        <Page Name="Success">
            <Label X="24" Y="108" Width="-24" Height="28" FontId="1" DisablePrefix="yes">
                <Text>#(loc.SuccessHeader)</Text>
                <Text Condition="WixBundleAction = 2">#(loc.SuccessLayoutHeader)</Text>
                <Text Condition="WixBundleAction = 3">#(loc.SuccessUninstallHeader)</Text>
                <Text Condition="WixBundleAction = 4">#(loc.SuccessUninstallHeader)</Text>
                <Text Condition="WixBundleAction = 5">#(loc.SuccessHeader)</Text>
                <Text Condition="WixBundleAction = 6">#(loc.SuccessInstallHeader)</Text>
                <Text Condition="WixBundleAction = 7">#(loc.SuccessInstallHeader)</Text>
                <Text Condition="WixBundleAction = 8">#(loc.SuccessRepairHeader)</Text>
            </Label>
            <Label X="24" Y="140" Width="-24" Height="40" FontId="2" DisablePrefix="yes">
                <Text Condition="WixBundleAction = 6 OR WixBundleAction = 7 OR WixBundleAction = 8">#(loc.SuccessInstallMessage)</Text>
            </Label>
            <Label X="24" Y="-56" Width="-24" Height="34" FontId="2" DisablePrefix="yes" VisibleCondition="WixStdBARestartRequired">#(loc.SuccessRestartText)</Label>
            <Button Name="SuccessRestartButton" X="-112" Y="-16" Width="88" Height="26" TabStop="yes" FontId="0" HideWhenDisabled="yes">#(loc.SuccessRestartButton)</Button>
            <Button Name="SuccessCloseButton" X="-16" Y="-16" Width="88" Height="26" TabStop="yes" FontId="0">
                <Text>#(loc.SuccessCloseButton)</Text>
                <CloseWindowAction />
            </Button>
        </Page>

        <Page Name="Failure">
            <Label X="24" Y="108" Width="-24" Height="28" FontId="1" DisablePrefix="yes">
                <Text>#(loc.FailureHeader)</Text>
                <Text Condition="WixBundleAction = 3">#(loc.FailureUninstallHeader)</Text>
                <Text Condition="WixBundleAction = 4">#(loc.FailureUninstallHeader)</Text>
                <Text Condition="WixBundleAction = 6">#(loc.FailureInstallHeader)</Text>
                <Text Condition="WixBundleAction = 7">#(loc.FailureInstallHeader)</Text>
                <Text Condition="WixBundleAction = 8">#(loc.FailureRepairHeader)</Text>
            </Label>
            <Hypertext Name="FailureLogFileLink" X="24" Y="140" Width="-24" Height="40" FontId="2" TabStop="yes" HideWhenDisabled="yes">#(loc.FailureHyperlinkLogText)</Hypertext>
            <Hypertext Name="FailureMessageText" X="24" Y="184" Width="-24" Height="60" FontId="2" TabStop="yes" HideWhenDisabled="yes" />
            <Label X="24" Y="-56" Width="-24" Height="34" FontId="2" DisablePrefix="yes" VisibleCondition="WixStdBARestartRequired">#(loc.FailureRestartText)</Label>
            <Button Name="FailureRestartButton" X="-112" Y="-16" Width="88" Height="26" TabStop="yes" FontId="0" HideWhenDisabled="yes">#(loc.FailureRestartButton)</Button>
            <Button Name="FailureCloseButton" X="-16" Y="-16" Width="88" Height="26" TabStop="yes" FontId="0">
                <Text>#(loc.FailureCloseButton)</Text>
                <CloseWindowAction />
            </Button>
        </Page>
    </Window>
</Theme>
