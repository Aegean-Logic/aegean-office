<?xml version="1.0" encoding="utf-8"?>
<!--
  Aegean Office Setup: one program that installs GridLogic, WordLogic and SlideLogic.

  A WiX Burn bundle chaining the three apps' own MSIs (each app's packaging/windows/package.ps1
  builds them). It asks for administrator rights once, installs the three in a row, and shows as
  one entry, Aegean Office, in Installed apps; uninstalling it removes all three. An app that was
  already installed on its own stays when the bundle is uninstalled.

  The Create desktop shortcuts box sets DesktopShortcuts, passed to each MSI as DESKTOPSHORTCUT
  (1 or 0). From the command line: AegeanOffice-…-setup.exe /quiet DesktopShortcuts=1.

  UpgradeCode is fixed for Aegean Office (generated 2026-10-19): never change it, or a newer
  Setup won't replace an older one. build.ps1 passes Version and the three MSI paths.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:bal="http://wixtoolset.org/schemas/v4/wxs/bal">
  <Bundle Name="Aegean Office"
          Manufacturer="Aegean Logic"
          Version="$(var.Version)"
          UpgradeCode="4382ECB8-293F-4C2F-A09A-F94B5B6570A4"
          IconSourceFile="branding\aegean-office.ico"
          AboutUrl="https://www.aegeanlogic.co.uk"
          HelpUrl="https://github.com/Aegean-Logic/aegean-office"
          Compressed="yes">

    <BootstrapperApplication>
      <!-- The hyperlinkLicense base with no LicenseUrl (no licence to accept), its theme and
           strings replaced by Aegean Office's own. -->
      <bal:WixStandardBootstrapperApplication Theme="hyperlinkLicense"
                                              LicenseUrl=""
                                              ThemeFile="theme.xml"
                                              LocalizationFile="theme.wxl"
                                              SuppressOptionsUI="yes" />
      <Payload SourceFile="branding\banner.png" Name="banner.png" />
      <Payload SourceFile="branding\gridlogic.png" Name="gridlogic.png" />
      <Payload SourceFile="branding\wordlogic.png" Name="wordlogic.png" />
      <Payload SourceFile="branding\slidelogic.png" Name="slidelogic.png" />
    </BootstrapperApplication>

    <Variable Name="DesktopShortcuts" Type="numeric" Value="0" Persisted="yes" bal:Overridable="yes" />

    <Chain>
      <MsiPackage Id="GridLogic" SourceFile="$(var.GridLogicMsi)">
        <MsiProperty Name="DESKTOPSHORTCUT" Value="[DesktopShortcuts]" />
      </MsiPackage>
      <MsiPackage Id="WordLogic" SourceFile="$(var.WordLogicMsi)">
        <MsiProperty Name="DESKTOPSHORTCUT" Value="[DesktopShortcuts]" />
      </MsiPackage>
      <MsiPackage Id="SlideLogic" SourceFile="$(var.SlideLogicMsi)">
        <MsiProperty Name="DESKTOPSHORTCUT" Value="[DesktopShortcuts]" />
      </MsiPackage>
    </Chain>
  </Bundle>
</Wix>
